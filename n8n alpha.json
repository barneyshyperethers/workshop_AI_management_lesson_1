    {
      "parameters": {
        "jsCode": "const dostawy = $('Wszystkie dostawy').all().map(i => i.json);\nconst cel = {};\n$input.all().forEach(r => { cel[r.json.owoc] = Number(r.json.cel); });\nconst nazwy = { jablka: 'Jabłka', banany: 'Banany', ananasy: 'Ananasy' };\nconst suma = { jablka: 0, banany: 0, ananasy: 0 };\ndostawy.forEach(d => { Object.keys(suma).forEach(k => { suma[k] += Number(d[k]) || 0; }); });\nconst linie = Object.keys(cel).map(k => {\n  const r = suma[k] - cel[k];\n  const status = r === 0 ? 'OK' : (r < 0 ? 'brakuje ' + (-r) : 'przekroczone o ' + r);\n  return (nazwy[k] || k) + ': ' + suma[k] + '/' + cel[k] + ' (' + status + ')';\n});\nreturn [{ json: { raport: linie.join('\\n'), liczba_dostaw: dostawy.length, suma: suma } }];"
      },
